# Anthropic key for the agent (loaded by SDK from env)
ANTHROPIC_API_KEY=
# Base URL of the py-backend API
THINKLYS_API_BASE=http://localhost:8000
# Short-lived JWT access token for the test user (paste before running)
THINKLYS_JWT=
# Command used to spawn the MCP server when wired
MCP_SERVER_COMMAND=tsx
# Args to spawn the MCP server
MCP_SERVER_ARGS=src/mcp/server.ts
# Shared secret matching rag-server's RAG_INTERNAL_SECRET.
# Only needed if the agent talks to rag-server directly (debug). Normally
# the agent calls py-backend, which forwards with this header itself.
# RAG_INTERNAL_SECRET=
