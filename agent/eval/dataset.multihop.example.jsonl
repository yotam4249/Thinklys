// Seed multi-hop cases. Each question requires two-plus retrievals across
// different documents or two-plus tool calls of different kinds to answer
// correctly. The `tags: ["multihop"]` label is what `metrics.ts` slices on
// for the multihopPct metric; the planner-executor PR (agent-12) needs to
// improve on the single-agent's pass-rate here. Run with:
//   npm run eval eval/dataset.multihop.example.jsonl
{"id": "mh-1", "question": "What do my notes say about transformers, and summarize the document it came from?", "expected": "Surfaces the transformers content (self-attention, query/key/value, O(n^2) complexity) AND identifies + summarises the specific document (deep-learning or transformers note) that contained it. Both halves must be grounded — the question is not answered if only one half is present.", "tags": ["multihop", "search-then-summarize"]}
{"id": "mh-2", "question": "Which document covers the bias-variance tradeoff, and what other ML concepts does that same document cover?", "expected": "Identifies the specific ML-notes document via discovery (search or list), then enumerates its other topics by summarising that document. Requires at least one document-identification step and one within-document exploration step.", "tags": ["multihop", "discovery-then-summary"]}
{"id": "mh-3", "question": "Compare what my notes say about backpropagation versus what they say about gradient descent — same document or different?", "expected": "Retrieves backpropagation content, retrieves gradient-descent content, names the source document(s) for each, and explicitly addresses whether they are in the same file or not. Requires two distinct searches and reasoning about document_id equality.", "tags": ["multihop", "compare", "cross-document"]}
{"id": "mh-4", "question": "List the documents I have, then summarize whichever one is most directly about attention mechanisms.", "expected": "Calls list_documents to enumerate (or otherwise surfaces titles), then picks the attention-related document and summarises it with citations. Strictly two-step: enumeration THEN focused summary.", "tags": ["multihop", "list-then-summarize"]}
{"id": "mh-5", "question": "Find the document that mentions 'cross-entropy loss' and tell me what the section just before that mention is about.", "expected": "Retrieves the cross-entropy chunk, identifies its position in the source document, then fetches and characterises the preceding section. Requires search → identification → ordered-chunk retrieval (get_document_section).", "tags": ["multihop", "search-then-section"]}
{"id": "mh-6", "question": "Of my documents, which one is the shortest, and what topic does it cover?", "expected": "Calls list_documents (chunk counts) to identify the shortest document, then summarises or characterises its content. Requires comparison across the document list plus a follow-up content lookup.", "tags": ["multihop", "list-then-summarize", "compare"]}
